{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DownKit",
  "version": "0.1.0",
  "identifier": "com.downkit.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DownKit",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "aderimo",
    "copyright": "© 2026 aderimo — MIT",
    "homepage": "https://gitgit.me/aderimo",
    "category": "Video",
    "shortDescription": "İndir, dönüştür, sıkıştır, hazırla.",
    "longDescription": "YouTube, TikTok, Instagram, X, Kick ve daha fazlasından video/ses indirme; dönüştürme, sıkıştırma ve sosyal medyaya hazırlama. Ücretsiz ve açık kaynak.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "../branding/installer-header.bmp",
        "sidebarImage": "../branding/installer-sidebar.bmp",
        "startMenuFolder": "DownKit"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEOTgyNDQ0QzRENjJCM0UKUldRK0s5YkVSQ1NZelY3UFlSMDgzTzlzTnJEcHRmNGdka1NnRU15Z3R5SjFBdmgzOTFxYU1ydnYK",
      "endpoints": ["https://github.com/Aderimo/downkit/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["downkit"]
      }
    }
  }
}
